{# =========================================================================
   Footer
   Logo, four columns (contact, pages, social, headline + text), partner
   logos and legal line.
   Data: footer single, mainNavigation structure.
   ========================================================================= #}

{%- set footer = craft.entries.section('footer').one() -%}
{%- set pages = craft.entries.section('mainNavigation').all() -%}
{%- set addressLines = (footer.contactAddress ?? '')|split("\n")|map(line => line|trim)|filter(line => line) -%}
{%- set socials = [
    { label: 'LinkedIn', link: footer.socialLinkedin ?? null },
    { label: 'Instagram', link: footer.socialInstagram ?? null },
    { label: 'Facebook', link: footer.socialFacebook ?? null },
    { label: 'X (Twitter)', link: footer.socialTwitter ?? null },
]|filter(social => social.link and social.link.url) -%}
{%- set footerLogos = footer ? footer.footerLogos.with(['logo']).all() : [] -%}

<footer class="relative z-10 bg-navy-deep pt-[88px] pb-12 text-white">
    <div class="container-wrap">
        {%- include '_partials/redesign/logo' with { utilities: 'block h-auto w-[150px] text-white' } only -%}

        <div class="mt-14 grid gap-12 text-copy-sm tablet:grid-cols-[1.1fr_1fr_1fr_1.4fr]">
            <div>
                <h2 class="text-label-sm text-ink-light">Kontakt</h2>
                <address class="not-italic">
                    <ul class="mt-3 space-y-2">
                        {%- for line in addressLines %}
                            <li>{{ line }}</li>
                        {%- endfor %}
                        {%- if footer.contactPhone.url ?? false %}
                            <li><a href="{{ footer.contactPhone.url }}" class="no-underline hover:underline">{{ footer.contactPhone.label }}</a></li>
                        {%- endif %}
                        {%- if footer.contactEmail.url ?? false %}
                            <li><a href="{{ footer.contactEmail.url }}" class="no-underline hover:underline">{{ footer.contactEmail.label }}</a></li>
                        {%- endif %}
                    </ul>
                </address>
            </div>

            {%- if pages|length %}
                <nav aria-label="Seiten">
                    <h2 class="text-label-sm text-ink-light">Seiten</h2>
                    <ul class="mt-3 space-y-2">
                        {%- for page in pages %}
                            {%- set link = page.customLink -%}
                            {%- if link and link.url %}
                                <li><a href="{{ link.url }}" class="no-underline hover:underline"{% if link.target %} target="{{ link.target }}"{% endif %}>{{ link.label }}</a></li>
                            {%- endif %}
                        {%- endfor %}
                    </ul>
                </nav>
            {%- endif %}

            {%- if socials|length %}
                <nav aria-label="Social Media">
                    <h2 class="text-label-sm text-ink-light">Folgen</h2>
                    <ul class="mt-3 space-y-2">
                        {%- for social in socials %}
                            <li><a href="{{ social.link.url }}" class="no-underline hover:underline" target="_blank" rel="noopener noreferrer">{{ social.label }}</a></li>
                        {%- endfor %}
                    </ul>
                </nav>
            {%- endif %}

            {%- if (footer.footerHeadline ?? false) or (footer.footerText ?? false) %}
                <div>
                    {%- if footer.footerHeadline %}
                        <h2 class="text-label-sm text-ink-light">{{ footer.footerHeadline }}</h2>
                    {%- endif %}
                    {%- if footer.footerText %}
                        <div class="prose-plain mt-3">{{ footer.footerText }}</div>
                    {%- endif %}
                </div>
            {%- endif %}
        </div>

        {%- if footerLogos|length %}
            <ul class="mt-14 flex flex-wrap items-center gap-4">
                {%- for item in footerLogos %}
                    {%- set logo = item.logo|first -%}
                    {%- if logo %}
                        {%- set image = tag('img', {
                            src: logo.extension == 'svg' ? logo.url : logo.getUrl({ height: 144, mode: 'fit' }),
                            alt: item.title,
                            class: 'h-auto max-h-[52px] w-auto max-w-full object-contain',
                            loading: 'lazy',
                        }) -%}
                        <li>
                            {%- if item.externalLink.url ?? false %}
                                <a href="{{ item.externalLink.url }}" class="grid h-[84px] w-40 place-items-center bg-white p-4 transition-opacity hover:opacity-80" target="_blank" rel="noopener noreferrer">{{ image|raw }}</a>
                            {%- else %}
                                <div class="grid h-[84px] w-40 place-items-center bg-white p-4">{{ image|raw }}</div>
                            {%- endif %}
                        </li>
                    {%- endif %}
                {%- endfor %}
            </ul>
        {%- endif %}

        <div class="mt-[72px] flex flex-wrap items-center justify-between gap-6 border-t border-white/14 pt-6 text-caption">
            <span class="text-ink-light">&copy; {{ now|date('Y') }} {{ footer.copyrightText ?? '' }}</span>
            <ul class="flex gap-6">
                <li><a href="{{ url('impressum') }}" class="text-ink-light no-underline hover:underline">Impressum</a></li>
                <li><a href="{{ url('datenschutz') }}" class="text-ink-light no-underline hover:underline">Datenschutz</a></li>
            </ul>
        </div>
    </div>
</footer>

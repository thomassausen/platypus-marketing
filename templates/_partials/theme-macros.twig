{# =========================================================================
   Theme Macros
   Maps the stored backgroundColor values of the content builder blocks to
   the 2026 palette. The stored values (gradient, blue, orange, …) stay the
   same so existing content keeps working.

   Usage:
   {% import '_partials/theme-macros.twig' as theme %}
   {% set vars = theme.getThemeVars(background)|json_decode %}
   ========================================================================= #}

{% macro getThemeVars(background) %}
    {%- set background = background ?? 'white' -%}

    {# Light defaults (white / transparent) #}
    {%- set vars = {
        dark: false,
        backgroundClass: '',
        textColorClass: 'text-ink',
        mutedClass: 'text-ink-muted',
        titleColorClass: 'text-ink',
        subtitleBgClass: 'text-navy',
        highlightClass: 'text-gold-deep',
        cardBgClass: 'bg-beige',
        cardTextClass: 'text-ink',
        cardTitleClass: 'text-ink',
        checkmarkClass: 'bg-gold',
        bulletClass: 'before:bg-gold',
        lineClass: 'border-line',
        accentBorderClass: 'border-gold',
        buttonPrimary: 'navy',
        buttonSecondary: 'outline',
    } -%}

    {%- set light = {
        soft: { backgroundClass: 'bg-beige', cardBgClass: 'bg-white', lineClass: 'border-stone' },
        white: { backgroundClass: 'bg-white', cardBgClass: 'bg-beige' },
        accent: { backgroundClass: 'bg-coral-trace', subtitleBgClass: 'text-coral-deep', highlightClass: 'text-coral-deep', cardBgClass: 'bg-white', accentBorderClass: 'border-coral' },
        orange: { backgroundClass: 'bg-gold', subtitleBgClass: 'text-ink', highlightClass: 'text-navy', mutedClass: 'text-ink/75', cardBgClass: 'bg-gold-light', checkmarkClass: 'bg-navy', bulletClass: 'before:bg-navy', lineClass: 'border-ink/18', accentBorderClass: 'border-navy' },
        teal: { backgroundClass: 'bg-petrol', subtitleBgClass: 'text-ink', highlightClass: 'text-navy', mutedClass: 'text-ink/75', cardBgClass: 'bg-petrol-trace', checkmarkClass: 'bg-navy', bulletClass: 'before:bg-navy', lineClass: 'border-ink/18', accentBorderClass: 'border-navy' },
    } -%}

    {%- set darkBase = {
        dark: true,
        textColorClass: 'text-white',
        mutedClass: 'text-ink-light',
        titleColorClass: 'text-white',
        subtitleBgClass: 'text-petrol',
        highlightClass: 'text-gold',
        cardTextClass: 'text-white',
        cardTitleClass: 'text-white',
        checkmarkClass: 'bg-gold',
        lineClass: 'border-white/18',
        accentBorderClass: 'border-gold',
        buttonPrimary: 'gold',
        buttonSecondary: 'outline-light',
    } -%}

    {%- set dark = {
        gradient: { backgroundClass: 'bg-navy-deep', cardBgClass: 'bg-navy' },
        blue: { backgroundClass: 'bg-navy', cardBgClass: 'bg-navy-deep' },
        purple: { backgroundClass: 'bg-plum', subtitleBgClass: 'text-plum-light', mutedClass: 'text-plum-trace', cardBgClass: 'bg-plum-deep' },
    } -%}

    {%- if light[background] is defined -%}
        {%- set vars = vars|merge(light[background]) -%}
    {%- elseif dark[background] is defined -%}
        {%- set vars = vars|merge(darkBase)|merge(dark[background]) -%}
    {%- endif -%}

    {# Legacy keys used by older templates #}
    {%- set vars = vars|merge({
        buttonClass: vars.buttonPrimary,
        buttonTextClass: '',
    }) -%}

    {{- vars|json_encode|raw -}}
{% endmacro %}

{# Container width dropdown → classes (2026 grid: 1200px incl. gutter) #}
{% macro containerClass(width, fallback) %}
    {%- set width = width ?? fallback ?? 'default' -%}
    {%- set map = {
        narrow: 'container-wrap max-w-[960px]',
        default: 'container-wrap',
        wide: 'container-wrap max-w-[1440px]',
        full: 'container-wrap max-w-none',
    } -%}
    {{- map[width] ?? map.default -}}
{% endmacro %}

{# Topic colour → classes. kind: panel (news card), chip (labels), header (article head) #}
{% macro topicClass(topic, kind) %}
    {%- set color = topic.topicColor.value ?? null -%}
    {%- set map = {
        panel: { petrol: 'bg-petrol-light', plum: 'bg-plum-light', coral: 'bg-coral-light' },
        chip: { petrol: 'bg-petrol-light', plum: 'bg-plum-mist', coral: 'bg-coral-trace' },
        header: { petrol: 'bg-petrol-light', plum: 'bg-plum-light', coral: 'bg-coral-light' },
    } -%}
    {{- map[kind][color] ?? (kind == 'chip' ? 'bg-ground' : 'bg-mist') -}}
{% endmacro %}

{# Reading time in minutes (200 words per minute, at least 1) #}
{% macro readingTime(post) %}
    {%- set words = (post.blogContent ?? '')|striptags|split(' ')|filter(word => word|trim)|length -%}
    {{- max(1, (words / 200)|round(0, 'ceil')) -}}
{% endmacro %}

{# =========================================================================
   UI Macros
   Shared pieces of the older content builder blocks, rendered in the 2026
   design (label, headings, buttons).

   Usage:
   {% import '_partials/ui-macros.twig' as ui %}
   {{ ui.subtitle(entry.subtitle, vars.subtitleBgClass) }}
   ========================================================================= #}

{# Label above a heading #}
{% macro subtitle(text, colorClass) %}
    {%- if text -%}
        <p class="mb-5 text-label {{ colorClass }}">{{ text }}</p>
    {%- endif -%}
{% endmacro %}

{# Single link button. variant: navy | gold | outline | outline-light #}
{% macro buttonPrimary(button, variant) %}
    {%- if button and button.url -%}
        {%- include '_partials/redesign/button' with {
            text: button.label,
            url: button.url,
            target: button.target,
            variant: variant in ['navy', 'gold', 'outline', 'outline-light'] ? variant : 'navy',
            arrow: true,
        } only -%}
    {%- endif -%}
{% endmacro %}

{% macro buttonSecondary(button, variant) %}
    {%- if button and button.url -%}
        {%- include '_partials/redesign/button' with {
            text: button.label,
            url: button.url,
            target: button.target,
            variant: variant in ['outline', 'outline-light'] ? variant : 'outline',
        } only -%}
    {%- endif -%}
{% endmacro %}

{# Buttons matrix (primary / secondary) #}
{% macro buttonGroup(buttons, vars, alignment) %}
    {%- set items = buttons.all() ?? buttons ?? [] -%}
    {%- if items|length -%}
        <div class="flex flex-wrap gap-3 {{ alignment == 'center' ? 'justify-center' }}">
            {%- include '_partials/redesign/buttons' with {
                buttons: items,
                primary: vars.buttonPrimary ?? 'navy',
                secondary: vars.buttonSecondary ?? 'outline',
            } only -%}
        </div>
    {%- endif -%}
{% endmacro %}

{# The decorative blob shapes are not part of the 2026 design #}
{% macro svgShapes(svgVariant, vars) %}{% endmacro %}

{# Section header: label, heading, lead, text #}
{% macro sectionHeader(subtitle, title, description, text, vars, alignment) %}
    {%- set centered = (alignment ?? 'left') == 'center' -%}
    <div class="{{ centered ? 'mx-auto max-w-[64ch] text-center' : 'max-w-[64ch]' }}">
        {{ _self.subtitle(subtitle, vars.subtitleBgClass) }}
        {%- if title %}
            <h2 class="text-h2 {{ vars.titleColorClass }}">{{ title }}</h2>
        {%- endif %}
        {%- if description %}
            <div class="prose-plain content-styles mt-5 text-lead {{ vars.textColorClass }}">{{ description }}</div>
        {%- endif %}
        {%- if text %}
            <div class="prose-plain content-styles mt-5 {{ vars.textColorClass }}">{{ text }}</div>
        {%- endif %}
    </div>
{% endmacro %}

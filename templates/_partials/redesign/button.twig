{# =========================================================================
   Button
   Link button of the 2026 design.
   Props: text, url, variant (navy|white|outline-navy|gold|outline|outline-light),
          size (default|small), arrow (bool), icon (icon name for the arrow,
          default 'arrow'), target, utilities (extra classes)
   ========================================================================= #}

{%- set variants = {
    navy: 'border-transparent bg-navy text-white hover:bg-navy-deep hover:text-white',
    white: 'border-transparent bg-white text-ink hover:bg-ink hover:text-white',
    'outline-navy': 'border-navy text-navy hover:bg-navy hover:text-white',
    gold: 'border-transparent bg-gold text-ink hover:bg-gold-hover',
    outline: 'text-ink border-ink hover:bg-ink hover:text-white',
    'outline-light': 'text-white border-white/40 hover:border-white',
} -%}

{%- set sizes = {
    default: 'min-h-12 gap-3 px-6 border max-phablet:whitespace-normal max-phablet:py-3',
    small: 'min-h-[47px] gap-[10px] px-[18px] border-[1.5px]',
} -%}

{%- set classes = collect({
    layout: 'inline-flex items-center whitespace-nowrap',
    size: sizes[size ?? 'default'] ?? sizes.default,
    shape: 'rounded-[4px] no-underline cursor-pointer',
    type: 'text-label',
    motion: 'transition-[background-color,color,border-color] duration-150',
    variant: variants[variant ?? 'navy'] ?? variants.navy,
    utilities: utilities ?? null,
}) -%}

{%- if url ?? false -%}
<a href="{{ url }}" class="{{ classes.filter(v => v).implode(' ') }}"{% if target ?? false %} target="{{ target }}"{% if target == '_blank' %} rel="noopener noreferrer"{% endif %}{% endif %}>
    {{- text -}}
    {%- if arrow ?? false %} {% include '_partials/redesign/icon' with { name: icon ?? 'arrow', utilities: (size ?? 'default') == 'small' ? 'size-4' : 'size-[18px]' } only %}{% endif -%}
</a>
{%- endif -%}

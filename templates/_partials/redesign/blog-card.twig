{# =========================================================================
   Blog card
   Teaser card for a blog post: image, date, title, summary, read more.
   The whole card is clickable (stretched link on the title).
   Props: post (blog entry), headingLevel (default 3), utilities
   ========================================================================= #}

{%- set image = post.blogFeaturedImage.one() ?? null -%}
{%- set heading = 'h' ~ (headingLevel ?? 3) -%}

<article class="group relative flex flex-col bg-white {{ utilities ?? '' }}">
    <div class="aspect-[3/2] overflow-hidden bg-beige">
        {%- if image %}
            {{ tag('img', {
                src: image.extension == 'svg' ? image.url : image.getUrl({ width: 800, height: 534, mode: 'crop', format: 'webp', quality: 82 }),
                alt: '',
                width: 800,
                height: 534,
                loading: 'lazy',
                class: 'h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100',
            }) }}
        {%- else %}
            <div class="grid h-full place-items-center">
                {%- include '_partials/redesign/platypus-mark' with { utilities: 'w-1/2 text-petrol' } only -%}
            </div>
        {%- endif %}
    </div>
    <div class="flex flex-1 flex-col gap-3 p-7">
        <time class="text-label-sm text-ink-muted" datetime="{{ post.postDate|date('Y-m-d') }}">{{ post.postDate|date('d. F Y') }}</time>
        {%- tag heading with { class: 'text-[21px] leading-[30px] font-normal' } %}
            <a href="{{ post.url }}" class="no-underline after:absolute after:inset-0 after:content-[''] group-hover:text-navy">{{ post.title }}</a>
        {%- endtag %}
        {%- if post.blogSummary %}
            <p class="line-clamp-3 text-copy-sm text-ink-muted">{{ post.blogSummary }}</p>
        {%- endif %}
        <span class="mt-auto inline-flex items-center gap-2 pt-2 text-label leading-[26px] text-navy" aria-hidden="true">
            Weiterlesen
            {%- include '_partials/redesign/icon' with { name: 'arrow', utilities: 'size-4 transition-transform duration-150 group-hover:translate-x-0.5 group-hover:-translate-y-0.5' } only -%}
        </span>
    </div>
</article>

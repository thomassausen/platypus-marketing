{# =========================================================================
   Benefits
   Benefits with line icon, title and text (2026 design).
   Fields: subtitle, title, description, benefits (title, description,
           iconType), columns, textAlignment, backgroundColor, containerWidth
   ========================================================================= #}

{%- import '_partials/theme-macros.twig' as theme -%}
{%- import '_partials/ui-macros.twig' as ui -%}

{%- set vars = theme.getThemeVars(entry.backgroundColor.value ?? entry.backgroundColor ?? 'white')|json_decode -%}
{%- set container = theme.containerClass(entry.containerWidth.value ?? entry.containerWidth ?? null, 'default') -%}
{%- set alignment = entry.textAlignment.value ?? entry.textAlignment ?? 'left' -%}
{%- set columns = (entry.columns.value ?? entry.columns ?? 2)|number_format -%}
{%- set benefits = entry.benefits.all() -%}

{# Line icons (24px grid, stroke) #}
{%- set icons = {
    check: '<path d="M5 13l4 4L19 7"/>',
    star: '<path d="M12 3l2.6 5.6 6.1.7-4.5 4.2 1.2 6L12 16.6 6.6 19.5l1.2-6L3.3 9.3l6.1-.7z"/>',
    rocket: '<path d="M13 10V3L4 14h7v7l9-11h-7z"/>',
    lightning: '<path d="M13 10V3L4 14h7v7l9-11h-7z"/>',
    chart: '<path d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"/>',
    users: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8M22 21v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8"/>',
    lightbulb: '<path d="M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7V17h8v-2.3A7 7 0 0 0 12 2z"/>',
    shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>',
    heart: '<path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1.1L12 21l7.8-7.5 1-1.1a5.5 5.5 0 0 0 0-7.8z"/>',
    trophy: '<path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4zM17 5h3v2a3 3 0 0 1-3 3M7 5H4v2a3 3 0 0 0 3 3"/>',
    'thumb-up': '<path d="M7 10v11H4V10h3zM7 10l4-8a3 3 0 0 1 3 3v4h5.5a2 2 0 0 1 2 2.3l-1.4 8a2 2 0 0 1-2 1.7H7"/>',
    'thumb-down': '<path d="M17 14V3h3v11h-3zM17 14l-4 8a3 3 0 0 1-3-3v-4H4.5a2 2 0 0 1-2-2.3l1.4-8a2 2 0 0 1 2-1.7H17"/>',
    warning: '<path d="M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/>',
    x: '<path d="M6 18L18 6M6 6l12 12"/>',
    close: '<path d="M6 18L18 6M6 6l12 12"/>',
    'x-circle': '<circle cx="12" cy="12" r="9"/><path d="m15 9-6 6M9 9l6 6"/>',
    ban: '<circle cx="12" cy="12" r="9"/><path d="M5.6 5.6l12.8 12.8"/>',
    'minus-circle': '<circle cx="12" cy="12" r="9"/><path d="M8 12h8"/>',
    'alert-circle': '<circle cx="12" cy="12" r="9"/><path d="M12 8v4M12 16h.01"/>',
} -%}

<section class="relative overflow-hidden section-band {{ vars.backgroundClass }} {{ vars.textColorClass }}">
    <div class="{{ container }}">
        {{ ui.sectionHeader(entry.subtitle, entry.title, entry.description, null, vars, alignment) }}

        {%- if benefits|length %}
            <div class="mt-14 grid gap-x-12 gap-y-10 tablet:grid-cols-[repeat(2,1fr)] {{ columns == '3' ? 'desktop:grid-cols-[repeat(3,1fr)]' }}">
                {%- for benefit in benefits %}
                    {%- set iconType = (benefit.iconType.value ?? benefit.iconType ?? 'check')|trim -%}
                    <div class="border-t pt-6 {{ vars.lineClass }}">
                        <svg class="size-8 fill-none stroke-current [stroke-linecap:round] [stroke-linejoin:round] [stroke-width:1.5] {{ vars.highlightClass }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">{{ (icons[iconType] ?? icons.check)|raw }}</svg>
                        <h3 class="mt-4 text-[19px] leading-[26px] font-normal {{ vars.titleColorClass }}">{{ benefit.title }}</h3>
                        {%- if benefit.description %}
                            <div class="prose-plain content-styles mt-2 text-copy-sm {{ vars.mutedClass }}">{{ benefit.description }}</div>
                        {%- endif %}
                    </div>
                {%- endfor %}
            </div>
        {%- endif %}
    </div>
</section>

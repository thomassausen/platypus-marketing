{# =========================================================================
   CTA
   Light grey contact box inside a page (e.g. "Ist COMPASS der richtige
   Weg für Sie?"). The petrol "next step" CTA is global, see footer.twig.
   Fields: anchor, subtitle (label), title (heading), description (lead),
           text, buttons (primary = navy, secondary = white).
   ========================================================================= #}

{%- set buttons = entry.buttons.all() -%}

<section{{ attr({ id: entry.anchor ?: false }) }} class="container-wrap scroll-mt-40 py-12 tablet:py-16">
    <div class="flex flex-wrap items-end justify-between gap-8 bg-mist p-8 tablet:p-12">
        <div class="flex min-w-0 flex-[1_1_520px] flex-col gap-[14px]">
            {%- if entry.subtitle %}
                <p class="text-label text-ink-muted">{{ entry.subtitle }}</p>
            {%- endif %}

            <h2 class="text-[clamp(30px,3.4vw,40px)] leading-[1.2] font-light tracking-[-.01em]">{{ entry.title }}</h2>

            {%- if entry.description %}
                <div class="prose-plain text-lead">{{ entry.description }}</div>
            {%- endif %}

            {%- if entry.text %}
                <div class="prose-plain">{{ entry.text }}</div>
            {%- endif %}
        </div>

        {%- if buttons|length %}
            <div class="flex flex-wrap gap-3">
                {%- include '_partials/redesign/buttons' with {
                    buttons: buttons,
                    primary: 'navy',
                    secondary: 'white',
                } only -%}
            </div>
        {%- endif %}
    </div>
</section>

{# =========================================================================
   FAQ
   Accordion with native <details>, styled like the 2026 lists.
   Fields: subtitle, heading, text, faqItems (question, answer),
           textAlignment, backgroundColor, containerWidth
   ========================================================================= #}

{%- import '_partials/theme-macros.twig' as theme -%}
{%- import '_partials/ui-macros.twig' as ui -%}

{%- set vars = theme.getThemeVars(entry.backgroundColor.value ?? entry.backgroundColor ?? 'white')|json_decode -%}
{%- set container = theme.containerClass(entry.containerWidth.value ?? entry.containerWidth ?? null, 'narrow') -%}
{%- set alignment = entry.textAlignment.value ?? entry.textAlignment ?? 'left' -%}
{%- set items = entry.faqItems.all() -%}

<section class="relative section-band {{ vars.backgroundClass }} {{ vars.textColorClass }}">
    <div class="{{ container }}">
        {{ ui.sectionHeader(entry.subtitle, entry.heading ?? entry.title, null, entry.text, vars, alignment) }}

        {%- if items|length %}
            <div class="mt-14 border-b {{ vars.lineClass }}">
                {%- for item in items %}
                    <details class="group border-t {{ vars.lineClass }}" name="faq-{{ entry.id }}">
                        <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-[19px] leading-[26px] [&::-webkit-details-marker]:hidden {{ vars.titleColorClass }}">
                            <span>{{ item.question }}</span>
                            {%- include '_partials/redesign/icon' with { name: 'chevron', utilities: 'size-5 transition-transform duration-200 group-open:rotate-180' } only -%}
                        </summary>
                        <div class="prose-plain content-styles max-w-[64ch] pb-6 {{ vars.mutedClass }}">{{ item.answer }}</div>
                    </details>
                {%- endfor %}
            </div>
        {%- endif %}
    </div>
</section>

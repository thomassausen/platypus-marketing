{# =========================================================================
   FAQ
   Content builder block; renders the shared FAQ partial with the first
   answer open.
   Fields: subtitle, heading, text, faqItems (question, answer)
   The older fields textAlignment, backgroundColor and containerWidth are
   no longer used.
   ========================================================================= #}

{%- include '_partials/redesign/faq' with {
    id: 'faq',
    label: entry.subtitle,
    heading: entry.heading ?? entry.title,
    text: entry.text,
    items: entry.faqItems.all(),
    openFirst: true,
    utilities: 'pt-16 pb-8 tablet:pt-24',
} only -%}

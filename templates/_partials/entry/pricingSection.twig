{# =========================================================================
   Pricing
   Pricing tiers styled like the 2026 model cards. A highlighted tier is
   rendered in navy.
   Fields: subtitle, title, tiers (title, highlighted, features (title,
           contentType true|false|text, text), price, billingModel),
           disclaimer, backgroundColor, containerWidth
   ========================================================================= #}

{%- import '_partials/theme-macros.twig' as theme -%}
{%- import '_partials/ui-macros.twig' as ui -%}

{%- set vars = theme.getThemeVars(entry.backgroundColor.value ?? entry.backgroundColor ?? 'soft')|json_decode -%}
{%- set container = theme.containerClass(entry.containerWidth.value ?? entry.containerWidth ?? null, 'default') -%}
{%- set tiers = entry.tiers.all() -%}

<section class="relative section-band {{ vars.backgroundClass }} {{ vars.textColorClass }}">
    <div class="{{ container }}">
        {{ ui.sectionHeader(entry.subtitle, entry.title, null, null, vars, 'left') }}

        {%- if tiers|length %}
            <div class="mt-14 grid gap-4 tablet:grid-cols-[repeat(2,1fr)] desktop:grid-cols-[repeat(3,1fr)]">
                {%- for tier in tiers %}
                    {%- set highlighted = tier.highlighted ?? false -%}
                    <article class="flex flex-col gap-6 p-8 {{ highlighted ? 'bg-navy-deep text-white' : (vars.dark ? 'bg-white text-ink' : vars.cardBgClass ~ ' text-ink') }}">
                        <h3 class="font-display text-[44px] leading-none">{{ tier.title }}</h3>
                        {%- set features = tier.features.all() -%}
                        {%- if features|length %}
                            <ul class="text-copy-sm">
                                {%- for feature in features %}
                                    {%- set type = feature.contentType.value ?? feature.contentType ?? 'text' -%}
                                    <li class="flex items-center justify-between gap-4 border-t py-[9px] {{ highlighted ? 'border-white/18' : 'border-ink/18' }}">
                                        <span>{{ feature.title }}</span>
                                        {%- if type == 'true' %}
                                            <span class="inline-flex items-center {{ highlighted ? 'text-gold' : 'text-gold-deep' }}">
                                                <svg class="size-5 fill-none stroke-current [stroke-linecap:round] [stroke-linejoin:round] [stroke-width:2]" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg>
                                                <span class="sr-only">enthalten</span>
                                            </span>
                                        {%- elseif type == 'false' %}
                                            <span class="inline-flex items-center {{ highlighted ? 'text-ink-light' : 'text-ink-muted' }}">
                                                <svg class="size-5 fill-none stroke-current [stroke-linecap:round] [stroke-width:2]" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 12h12"/></svg>
                                                <span class="sr-only">nicht enthalten</span>
                                            </span>
                                        {%- else %}
                                            <span class="text-right font-bold">{{ feature.text }}</span>
                                        {%- endif %}
                                    </li>
                                {%- endfor %}
                            </ul>
                        {%- endif %}
                        <div class="mt-auto">
                            <div class="text-[44px] leading-[1.1] font-light tracking-[-.02em]">{{ tier.price }}</div>
                            {%- if tier.billingModel %}
                                <p class="mt-1 text-copy-sm {{ highlighted ? 'text-ink-light' : 'text-ink-muted' }}">{{ tier.billingModel }}</p>
                            {%- endif %}
                        </div>
                        {%- include '_partials/redesign/button' with {
                            text: 'Paket anfragen',
                            url: url('kontakt'),
                            variant: highlighted ? 'gold' : 'navy',
                            arrow: true,
                            utilities: 'justify-center',
                        } only -%}
                    </article>
                {%- endfor %}
            </div>
        {%- endif %}

        {%- if entry.disclaimer ?? false %}
            <p class="mt-10 max-w-[64ch] text-copy-sm {{ vars.mutedClass }}">{{ entry.disclaimer }}</p>
        {%- endif %}
    </div>
</section>

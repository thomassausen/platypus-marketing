{# =========================================================================
   Content blocks
   Heading with several sub-blocks (2026 design).
   Fields: subtitle, heading, text, contentBlocks (blockTitle, blockText,
           blockIcon), highlightStyle (default | box | border-left),
           showNumbering, columns, textAlignment, backgroundColor,
           containerWidth
   ========================================================================= #}

{%- import '_partials/theme-macros.twig' as theme -%}
{%- import '_partials/ui-macros.twig' as ui -%}

{%- set vars = theme.getThemeVars(entry.backgroundColor.value ?? entry.backgroundColor ?? 'white')|json_decode -%}
{%- set container = theme.containerClass(entry.containerWidth.value ?? entry.containerWidth ?? null, 'default') -%}
{%- set alignment = entry.textAlignment.value ?? entry.textAlignment ?? 'left' -%}
{%- set columns = (entry.columns.value ?? entry.columns ?? 1)|number_format -%}
{%- set highlightStyle = entry.highlightStyle.value ?? entry.highlightStyle ?? 'default' -%}
{%- set showNumbering = entry.showNumbering ?? false -%}
{%- set blocks = entry.contentBlocks.all() -%}
{%- set gridClasses = {
    '1': 'max-w-[760px]',
    '2': 'tablet:grid-cols-[repeat(2,1fr)]',
    '3': 'tablet:grid-cols-[repeat(2,1fr)] desktop:grid-cols-[repeat(3,1fr)]',
    '4': 'tablet:grid-cols-[repeat(2,1fr)] desktop:grid-cols-[repeat(4,1fr)]',
} -%}
{%- set itemClasses = {
    box: 'p-8 ' ~ vars.cardBgClass ~ ' ' ~ vars.cardTextClass,
    'border-left': 'border-l-4 py-1 pl-6 ' ~ vars.accentBorderClass,
    default: 'border-t pt-6 ' ~ vars.lineClass,
} -%}

<section class="relative overflow-hidden section-band {{ vars.backgroundClass }} {{ vars.textColorClass }}">
    <div class="{{ container }}">
        {{ ui.sectionHeader(entry.subtitle, entry.heading ?? entry.title, null, entry.text, vars, alignment) }}

        {%- if blocks|length %}
            <div class="mt-14 grid gap-x-12 gap-y-10 {{ gridClasses[columns] ?? gridClasses['1'] }} {{ alignment == 'center' and columns == '1' ? 'mx-auto' }}">
                {%- for block in blocks %}
                    <div class="{{ itemClasses[highlightStyle] ?? itemClasses.default }}">
                        <div class="flex items-baseline gap-4">
                            {%- if showNumbering %}
                                <span class="flex-none text-[28px] leading-8 font-light {{ vars.highlightClass }}" aria-hidden="true">{{ '%02d'|format(loop.index) }}</span>
                            {%- elseif block.blockIcon %}
                                <span class="flex-none text-[24px] leading-8" aria-hidden="true">{{ block.blockIcon }}</span>
                            {%- endif %}
                            <h3 class="text-h3 {{ highlightStyle == 'box' ? vars.cardTitleClass : vars.titleColorClass }}">{{ block.blockTitle }}</h3>
                        </div>
                        {%- if block.blockText %}
                            <div class="prose-plain content-styles mt-4">{{ block.blockText }}</div>
                        {%- endif %}
                    </div>
                {%- endfor %}
            </div>
        {%- endif %}
    </div>
</section>

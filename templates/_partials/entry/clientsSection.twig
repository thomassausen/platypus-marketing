{# =========================================================================
   Clients
   Client logo grid, styled like the 2026 logo row.
   Fields: subtitle, title, description, text, selectedClients (logo,
           externalLink), textAlignment, backgroundColor, containerWidth
   ========================================================================= #}

{%- import '_partials/theme-macros.twig' as theme -%}
{%- import '_partials/ui-macros.twig' as ui -%}

{%- set vars = theme.getThemeVars(entry.backgroundColor.value ?? entry.backgroundColor ?? 'soft')|json_decode -%}
{%- set container = theme.containerClass(entry.containerWidth.value ?? entry.containerWidth ?? null, 'default') -%}
{%- set alignment = entry.textAlignment.value ?? entry.textAlignment ?? 'left' -%}
{%- set clients = entry.selectedClients.with(['logo']).all() -%}

<section class="relative section-band {{ vars.backgroundClass }} {{ vars.textColorClass }}">
    <div class="{{ container }}">
        {{ ui.sectionHeader(entry.subtitle, entry.title, entry.description ?? null, entry.text, vars, alignment) }}

        {%- if clients|length %}
            <ul class="mt-14 grid grid-cols-[repeat(2,1fr)] gap-4 tablet:grid-cols-[repeat(5,1fr)]" aria-label="Kundenlogos">
                {%- for client in clients %}
                    {%- set logo = client.logo|first -%}
                    {%- if logo %}
                        {%- set image = tag('img', {
                            src: logo.extension == 'svg' ? logo.url : logo.getUrl({ height: 144, mode: 'fit' }),
                            alt: client.title,
                            class: 'h-auto max-h-[64px] w-auto max-w-full object-contain',
                            loading: 'lazy',
                        }) -%}
                        <li>
                            {%- if client.externalLink.url ?? false %}
                                <a href="{{ client.externalLink.url }}" class="grid h-[104px] place-items-center border border-line bg-white p-5 transition-opacity hover:opacity-80" target="_blank" rel="noopener noreferrer">{{ image|raw }}</a>
                            {%- else %}
                                <div class="grid h-[104px] place-items-center border border-line bg-white p-5">{{ image|raw }}</div>
                            {%- endif %}
                        </li>
                    {%- endif %}
                {%- endfor %}
            </ul>
        {%- endif %}
    </div>
</section>

{# =========================================================================
   Steps
   Numbered steps, styled like the 2026 "reasons" list.
   Fields: subtitle, title, description, steps (title, stepDescription),
           backgroundColor, containerWidth
   ========================================================================= #}

{%- import '_partials/theme-macros.twig' as theme -%}
{%- import '_partials/ui-macros.twig' as ui -%}

{%- set vars = theme.getThemeVars(entry.backgroundColor.value ?? entry.backgroundColor ?? 'soft')|json_decode -%}
{%- set container = theme.containerClass(entry.containerWidth.value ?? entry.containerWidth ?? null, 'default') -%}
{%- set steps = entry.steps.all() -%}

<section class="relative overflow-hidden section-band {{ vars.backgroundClass }} {{ vars.textColorClass }}">
    <div class="{{ container }} grid gap-8 tablet:grid-cols-[repeat(2,1fr)] tablet:gap-16">
        <div>
            {{ ui.sectionHeader(entry.subtitle, entry.title, entry.description, null, vars, 'left') }}
        </div>

        {%- if steps|length %}
            <ol>
                {%- for step in steps %}
                    <li class="grid grid-cols-[56px_1fr] gap-2 border-t py-[22px] {{ vars.lineClass }}">
                        <span class="text-[28px] leading-8 font-light {{ vars.highlightClass }}" aria-hidden="true">{{ '%02d'|format(loop.index) }}</span>
                        <div>
                            <h3 class="text-[19px] leading-[26px] font-normal {{ vars.titleColorClass }}">{{ step.title }}</h3>
                            {%- if step.stepDescription %}
                                <div class="prose-plain content-styles mt-1 text-copy-sm {{ vars.mutedClass }}">{{ step.stepDescription }}</div>
                            {%- endif %}
                        </div>
                    </li>
                {%- endfor %}
            </ol>
        {%- endif %}
    </div>
</section>

{# =========================================================================
   Deliverables
   Numbered tiles on petrol.
   Fields: anchor, subtitle, heading, description, items (title/text)
   ========================================================================= #}

{%- set items = (entry.items ?? [])|filter(row => row.title ?? false) -%}
{%- set columns = {
    1: 'desktop:grid-cols-[repeat(1,1fr)]',
    2: 'desktop:grid-cols-[repeat(2,1fr)]',
    3: 'desktop:grid-cols-[repeat(3,1fr)]',
    4: 'desktop:grid-cols-[repeat(4,1fr)]',
    5: 'desktop:grid-cols-[repeat(5,1fr)]',
} -%}

<section{{ attr({ id: entry.anchor ?: false }) }} class="relative overflow-hidden scroll-mt-24 section-band bg-petrol">
    <div class="container-wrap">
        {%- if entry.subtitle %}
            <p class="text-label text-ink">{{ entry.subtitle }}</p>
        {%- endif %}
        <h2 class="mt-5 max-w-[64ch] text-h2">
            {%- include '_partials/redesign/highlight' with { text: entry.heading, utilities: 'text-navy' } only -%}
        </h2>
        {%- if entry.description %}
            <div class="prose-plain mt-5 max-w-[64ch] text-lead">{{ entry.description }}</div>
        {%- endif %}

        {%- if items|length %}
            <div class="mt-14 grid gap-[2px] bg-petrol phablet:grid-cols-[repeat(2,1fr)] {{ columns[min(items|length, 5)] }}">
                {%- for item in items %}
                    <article class="flex flex-col gap-3 bg-petrol-trace px-[22px] pt-7 pb-8 {{ loop.last and items|length is odd ? 'phablet:col-span-full desktop:col-span-1' }}">
                        <span class="text-[40px] leading-10 font-light text-petrol-deep">{{ '%02d'|format(loop.index) }}</span>
                        <h3 class="text-[19px] leading-[26px] font-normal">{{ item.title }}</h3>
                        {%- if item.text ?? false %}
                            <p class="text-copy-sm text-ink-muted">{{ item.text|nl2br }}</p>
                        {%- endif %}
                    </article>
                {%- endfor %}
            </div>
        {%- endif %}
    </div>
</section>

{# =========================================================================
   Principles
   Section head (text right) and white cards with a numbered chip
   ("Prinzip 1", "Prinzip 2" …) in shades of the accent colour.
   Fields: subtitle, heading, accentColor, text, itemLabel,
           cards (table: title/text)
   ========================================================================= #}

{%- set accent = entry.accentColor.value ?? 'plum' -%}
{%- set cards = (entry.cards ?? [])|filter(row => row.title ?? false) -%}
{%- set chipTones = {
    plum: ['bg-plum-mist text-plum-deep', 'bg-plum-light text-ink', 'bg-plum text-white'],
    coral: ['bg-coral-trace text-coral-deep', 'bg-coral-light text-ink', 'bg-coral text-white'],
    petrol: ['bg-petrol-trace text-petrol-ink', 'bg-petrol-light text-ink', 'bg-petrol text-ink'],
}[accent] ?? [] -%}

<section class="container-wrap pt-16 tablet:pt-24">
    {%- include '_partials/redesign/section-head' with {
        label: entry.subtitle,
        heading: entry.heading,
        accent: accent,
        text: entry.text,
        split: 'wide',
    } only -%}

    {%- if cards|length %}
        <ul class="mt-12 grid grid-cols-[repeat(auto-fit,minmax(min(260px,100%),1fr))] gap-4">
            {%- for card in cards %}
                <li class="flex flex-col gap-3 bg-white p-6">
                    {%- if entry.itemLabel %}
                        <span class="inline-flex h-7 items-center self-start rounded-[2px] px-[10px] text-label-sm {{ chipTones[loop.index0 % 3] ?? '' }}">{{ entry.itemLabel }} {{ loop.index }}</span>
                    {%- endif %}
                    <h3 class="text-[28px] leading-9 font-light">{{ card.title }}</h3>
                    {%- if card.text ?? false %}
                        <p>{{ card.text|nl2br }}</p>
                    {%- endif %}
                </li>
            {%- endfor %}
        </ul>
    {%- endif %}
</section>

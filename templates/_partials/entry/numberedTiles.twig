{# =========================================================================
   Numbered tiles
   Section head (text right) and a petrol band with numbered tiles.
   Fields: subtitle, heading, accentColor, text, tiles (table: title/text)
   ========================================================================= #}

{%- set tiles = (entry.tiles ?? [])|filter(row => row.title ?? false) -%}

<section class="container-wrap pt-16 tablet:pt-24">
    {%- include '_partials/redesign/section-head' with {
        label: entry.subtitle,
        heading: entry.heading,
        accent: entry.accentColor.value ?? 'plum',
        text: entry.text,
        utilities: 'mb-10',
    } only -%}

    {%- if tiles|length %}
        <ol class="grid grid-cols-[repeat(auto-fit,minmax(min(190px,100%),1fr))] gap-3 bg-petrol p-6 tablet:p-10">
            {%- for tile in tiles %}
                <li class="flex flex-col gap-[10px] bg-petrol-trace px-5 py-6">
                    <span class="text-[40px] leading-11 font-light text-petrol-ink" aria-hidden="true">{{ '%02d'|format(loop.index) }}</span>
                    <span class="text-[17px] leading-6">{{ tile.title }}</span>
                    {%- if tile.text ?? false %}
                        <span class="text-[14px] leading-[21px] text-slate">{{ tile.text|nl2br }}</span>
                    {%- endif %}
                </li>
            {%- endfor %}
        </ol>
    {%- endif %}
</section>

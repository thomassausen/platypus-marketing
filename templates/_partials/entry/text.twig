{# =========================================================================
   Text
   One or two column text section in the 2026 design.
   Fields: subtitle, title, description, text, button, textLayout,
           stickyTitle, backgroundColor, containerWidth
   ========================================================================= #}

{%- import '_partials/theme-macros.twig' as theme -%}
{%- import '_partials/ui-macros.twig' as ui -%}

{%- set vars = theme.getThemeVars(entry.backgroundColor.value ?? entry.backgroundColor ?? 'white')|json_decode -%}
{%- set layout = entry.textLayout.value ?? entry.textLayout ?? 'one-column' -%}
{%- set container = theme.containerClass(entry.containerWidth.value ?? entry.containerWidth ?? null, 'default') -%}

<section class="relative section-band {{ vars.backgroundClass }} {{ vars.textColorClass }}">
    <div class="{{ container }}">
        {%- if layout == 'two-column' %}
            <div class="grid items-start gap-8 tablet:grid-cols-[repeat(2,1fr)] tablet:gap-16">
                <div class="{{ entry.stickyTitle ? 'tablet:sticky tablet:top-[124px]' }}">
                    {{ ui.subtitle(entry.subtitle, vars.subtitleBgClass) }}
                    <h2 class="text-h2 {{ vars.titleColorClass }}">{{ entry.title }}</h2>
                </div>
                <div>
                    {%- if entry.description %}
                        <div class="prose-plain content-styles text-lead">{{ entry.description }}</div>
                    {%- endif %}
                    {%- if entry.text %}
                        <div class="prose-plain content-styles {{ entry.description ? 'mt-5' }}">{{ entry.text }}</div>
                    {%- endif %}
                    {%- if entry.button and entry.button.url %}
                        <div class="mt-10">{{ ui.buttonPrimary(entry.button, vars.buttonPrimary) }}</div>
                    {%- endif %}
                </div>
            </div>
        {%- else %}
            <div class="max-w-[760px]">
                {%- include '_partials/text-content' with {
                    subtitle: entry.subtitle,
                    title: entry.title,
                    description: entry.description,
                    text: entry.text,
                    button: entry.button,
                    vars: vars,
                } only -%}
            </div>
        {%- endif %}
    </div>
</section>

{# =========================================================================
   Case study
   Key figure card, customer quote and logo row on light grey.
   Fields: anchor, subtitle, heading, figure, figureUnit, figureText,
           details (title/text), quote, quoteAuthor, quoteRole, buttons,
           selectedClients (clients with logo + externalLink)
   ========================================================================= #}

{%- set details = (entry.details ?? [])|filter(row => row.title ?? false) -%}
{%- set clients = entry.selectedClients.with(['logo']).all() -%}
{%- set buttons = entry.buttons.all() -%}

<section{{ attr({ id: entry.anchor ?: false }) }} class="relative overflow-hidden scroll-mt-24 section-band bg-ground">
    <div class="container-wrap">
        {%- if entry.subtitle %}
            <p class="text-label text-gold-deep">{{ entry.subtitle }}</p>
        {%- endif %}
        <h2 class="mt-5 text-h2">
            {%- include '_partials/redesign/highlight' with { text: entry.heading, utilities: 'text-gold-deep' } only -%}
        </h2>

        <div class="mt-14 grid gap-4 tablet:grid-cols-[.8fr_1.2fr]">
            {%- if entry.figure or entry.figureText or details|length %}
                <div class="flex flex-col justify-between gap-8 bg-gold-light p-8 tablet:p-10">
                    {%- if entry.figure or entry.figureText %}
                        <div>
                            {%- if entry.figure %}
                                <div class="text-[60px] leading-[60px] font-light tracking-[-.03em]">
                                    {{- entry.figure -}}
                                    {%- if entry.figureUnit %}<small class="ml-1 text-[28px]">{{ entry.figureUnit }}</small>{% endif -%}
                                </div>
                            {%- endif %}
                            {%- if entry.figureText %}
                                <p class="mt-3 text-copy-sm">{{ entry.figureText }}</p>
                            {%- endif %}
                        </div>
                    {%- endif %}
                    {%- if details|length %}
                        <dl class="text-copy-sm">
                            {%- for detail in details %}
                                <dt class="text-label-sm">{{ detail.title }}</dt>
                                <dd class="mt-1 {{ not loop.last ? 'mb-[14px]' }}">{{ (detail.text ?? '')|nl2br }}</dd>
                            {%- endfor %}
                        </dl>
                    {%- endif %}
                </div>
            {%- endif %}

            {%- if entry.quote %}
                <figure class="flex flex-col gap-7 bg-white p-8 tablet:p-10">
                    <blockquote class="text-quote">„{{ entry.quote }}“</blockquote>
                    {%- if entry.quoteAuthor or entry.quoteRole %}
                        <figcaption class="text-copy-sm">
                            {%- if entry.quoteAuthor %}<strong class="font-bold">{{ entry.quoteAuthor }}</strong>{% endif -%}
                            {%- if entry.quoteAuthor and entry.quoteRole %}<br>{% endif -%}
                            {%- if entry.quoteRole %}<span class="text-ink-muted">{{ entry.quoteRole }}</span>{% endif -%}
                        </figcaption>
                    {%- endif %}
                    {%- if buttons|length %}
                        <div class="flex flex-wrap gap-3 self-start">
                            {%- include '_partials/redesign/buttons' with { buttons: buttons, primary: 'outline', secondary: 'outline', arrow: false } only -%}
                        </div>
                    {%- endif %}
                </figure>
            {%- endif %}
        </div>

        {%- if clients|length %}
            <ul class="mt-14 grid grid-cols-[repeat(2,1fr)] gap-4 tablet:grid-cols-[repeat(5,1fr)]" aria-label="Kundenlogos">
                {%- for client in clients %}
                    {%- set logo = client.logo|first -%}
                    {%- if logo %}
                        {%- set image = tag('img', {
                            src: logo.getUrl({ height: 120, mode: 'fit' }),
                            alt: client.title,
                            class: 'max-h-full max-w-full object-contain',
                            loading: 'lazy',
                        }) -%}
                        <li>
                            {%- if client.externalLink.url ?? false %}
                                <a href="{{ client.externalLink.url }}" class="grid h-[84px] place-items-center border border-line bg-white p-4 transition-opacity hover:opacity-80" target="_blank" rel="noopener noreferrer">{{ image|raw }}</a>
                            {%- else %}
                                <div class="grid h-[84px] place-items-center border border-line bg-white p-4">{{ image|raw }}</div>
                            {%- endif %}
                        </li>
                    {%- endif %}
                {%- endfor %}
            </ul>
        {%- endif %}
    </div>
</section>

{# =========================================================================
   Reasons
   Statement with chips and numbered reasons, on navy.
   Fields: anchor, subtitle, heading (*…* = gold), chipsLabel, chips,
           items (title/text)
   ========================================================================= #}

{%- set chips = (entry.chips ?? [])|filter(row => row.text ?? false) -%}
{%- set items = (entry.items ?? [])|filter(row => row.title ?? false) -%}

<section{{ attr({ id: entry.anchor ?: false }) }} class="relative overflow-hidden scroll-mt-24 section-band bg-navy text-white">
    <div class="container-wrap grid gap-8 tablet:grid-cols-[repeat(2,1fr)] tablet:gap-16">
        <div>
            {%- if entry.subtitle %}
                <p class="text-label text-petrol">{{ entry.subtitle }}</p>
            {%- endif %}
            <h2 class="mt-5 text-h2">
                {%- include '_partials/redesign/highlight' with { text: entry.heading, utilities: 'text-gold' } only -%}
            </h2>
            {%- if entry.chipsLabel %}
                <p class="mt-6 text-lead text-ink-soft">{{ entry.chipsLabel }}</p>
            {%- endif %}
            {%- if chips|length %}
                <ul class="mt-7 flex flex-wrap gap-2">
                    {%- for chip in chips %}
                        <li class="inline-flex h-[34px] items-center rounded-[3px] bg-petrol/18 px-[14px] text-[11px] font-bold tracking-[.14em] text-petrol uppercase">{{ chip.text }}</li>
                    {%- endfor %}
                </ul>
            {%- endif %}
        </div>

        {%- if items|length %}
            <ol>
                {%- for item in items %}
                    <li class="grid grid-cols-[56px_1fr] gap-2 border-t border-white/18 py-[22px]">
                        <span class="text-[28px] leading-8 font-light text-gold" aria-hidden="true">{{ '%02d'|format(loop.index) }}</span>
                        <div>
                            <strong class="block text-[19px] leading-[26px] font-normal">{{ item.title }}</strong>
                            {%- if item.text ?? false %}
                                <span class="mt-1 block text-copy-sm text-ink-light">{{ item.text|nl2br }}</span>
                            {%- endif %}
                        </div>
                    </li>
                {%- endfor %}
            </ol>
        {%- endif %}
    </div>
</section>

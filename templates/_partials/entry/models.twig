{# =========================================================================
   Models
   Up to three coloured model cards on white.
   Fields: anchor, subtitle, heading, baseTag, baseText,
           modelCards (modelName, summary, items, cardLink)
   Card colours follow the order: stone, petrol, navy.
   ========================================================================= #}

{%- set cards = entry.modelCards.all() -%}
{%- set themes = [
    { card: 'bg-stone-light text-ink', summary: 'text-ink-muted', line: 'border-stone', link: '' },
    { card: 'bg-petrol text-ink', summary: 'text-[#33405F]', line: 'border-ink/18', link: '' },
    { card: 'bg-navy-deep text-white', summary: 'text-ink-light', line: 'border-white/18', link: 'text-gold' },
] -%}

<section{{ attr({ id: entry.anchor ?: false }) }} class="relative overflow-hidden scroll-mt-24 section-band bg-white">
    <div class="container-wrap">
        {%- if entry.subtitle %}
            <p class="text-label text-navy">{{ entry.subtitle }}</p>
        {%- endif %}
        <h2 class="mt-5 text-h2">
            {%- include '_partials/redesign/highlight' with { text: entry.heading, utilities: 'text-coral-deep' } only -%}
        </h2>

        {%- if entry.baseTag or entry.baseText %}
            <div class="mt-6 flex items-center gap-4 bg-beige px-6 py-[18px] text-copy-sm">
                {%- if entry.baseTag %}
                    <span class="inline-flex h-7 flex-none items-center rounded-[2px] bg-coral px-2.5 text-[10px] font-bold tracking-[.16em] text-ink uppercase">{{ entry.baseTag }}</span>
                {%- endif %}
                {%- if entry.baseText %}
                    <div class="prose-plain">{{ entry.baseText }}</div>
                {%- endif %}
            </div>
        {%- endif %}

        {%- if cards|length %}
            <div class="mt-14 grid gap-4 tablet:grid-cols-[repeat(3,1fr)]">
                {%- for card in cards %}
                    {%- set theme = themes[loop.index0 % 3] -%}
                    {%- set items = (card.items ?? [])|filter(row => row.text ?? false) -%}
                    <article class="flex flex-col gap-4 p-8 {{ theme.card }}">
                        <h3 class="font-display text-[44px] leading-none">{{ card.modelName }}</h3>
                        {%- if card.summary %}
                            <p class="{{ theme.summary }}">{{ card.summary }}</p>
                        {%- endif %}
                        {%- if items|length %}
                            <ul class="text-copy-sm">
                                {%- for item in items %}
                                    <li class="border-t py-[9px] {{ theme.line }}">{{ item.text }}</li>
                                {%- endfor %}
                            </ul>
                        {%- endif %}
                        {%- if card.cardLink and card.cardLink.url %}
                            <a href="{{ card.cardLink.url }}" class="mt-auto inline-flex items-center gap-2 text-label leading-[26px] no-underline hover:underline {{ theme.link }}"{% if card.cardLink.target %} target="{{ card.cardLink.target }}"{% endif %}>
                                {{- card.cardLink.label -}}
                                {% include '_partials/redesign/icon' with { name: 'arrow', utilities: 'size-4' } only %}
                            </a>
                        {%- endif %}
                    </article>
                {%- endfor %}
            </div>
        {%- endif %}
    </div>
</section>

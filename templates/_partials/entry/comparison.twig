{# =========================================================================
   Comparison
   "Classic way" vs. "Platypus way" on coral trace.
   Fields: anchor, subtitle, heading (*…* = coral), description,
           leftLabel, chips, callout, leftItems, rightLabel, rightHeading,
           rightItems
   ========================================================================= #}

{%- set chips = (entry.chips ?? [])|filter(row => row.text ?? false) -%}
{%- set leftItems = (entry.leftItems ?? [])|filter(row => row.text ?? false) -%}
{%- set rightItems = (entry.rightItems ?? [])|filter(row => row.text ?? false) -%}

<section{{ attr({ id: entry.anchor ?: false }) }} class="relative overflow-hidden scroll-mt-24 section-band bg-coral-trace">
    <div class="container-wrap">
        <div class="grid items-end gap-8 tablet:grid-cols-[1.1fr_.9fr] tablet:gap-16">
            <div>
                {%- if entry.subtitle %}
                    <p class="text-label text-coral-deep">{{ entry.subtitle }}</p>
                {%- endif %}
                <h2 class="mt-5 text-h2">
                    {%- include '_partials/redesign/highlight' with { text: entry.heading, utilities: 'text-coral-deep' } only -%}
                </h2>
            </div>
            {%- if entry.description %}
                <div class="prose-plain text-lead">{{ entry.description }}</div>
            {%- endif %}
        </div>

        <div class="mt-16 grid tablet:grid-cols-[repeat(2,1fr)]">
            <div class="bg-white p-8 tablet:p-12">
                {%- if entry.leftLabel %}
                    <p class="text-label text-ink-muted">{{ entry.leftLabel }}</p>
                {%- endif %}
                {%- if chips|length %}
                    <div class="mt-5 flex flex-wrap gap-2">
                        {%- for chip in chips %}
                            <span class="inline-flex h-[30px] items-center rounded-[3px] bg-coral-trace px-3 text-[13px] text-coral-deep line-through decoration-coral-deep/50">{{ chip.text }}</span>
                        {%- endfor %}
                    </div>
                {%- endif %}
                {%- if entry.callout %}
                    <p class="mt-7 bg-coral-light p-6 font-display text-[22px] leading-[1.35]">{{ entry.callout|nl2br }}</p>
                {%- endif %}
                {%- if leftItems|length %}
                    <ul class="mt-6">
                        {%- for item in leftItems %}
                            <li class="flex items-baseline gap-[14px] border-t border-line py-[14px] before:font-bold before:text-coral-deep before:content-['–']">{{ item.text }}</li>
                        {%- endfor %}
                    </ul>
                {%- endif %}
            </div>

            <div class="bg-navy p-8 text-white tablet:p-12">
                {%- if entry.rightLabel %}
                    <p class="text-label text-gold">{{ entry.rightLabel }}</p>
                {%- endif %}
                {%- if entry.rightHeading %}
                    <h3 class="mt-5 text-h3">{{ entry.rightHeading }}</h3>
                {%- endif %}
                {%- if rightItems|length %}
                    <ul class="mt-6">
                        {%- for item in rightItems %}
                            <li class="flex items-baseline gap-[14px] border-t border-white/18 py-[14px] before:size-2 before:flex-none before:-translate-y-0.5 before:rounded-full before:bg-gold before:content-['']">{{ item.text }}</li>
                        {%- endfor %}
                    </ul>
                {%- endif %}
            </div>
        </div>
    </div>
</section>

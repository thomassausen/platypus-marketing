{# =========================================================================
   Case list
   Section head, the first case of the "cases" structure as a large grey
   feature (summary + facts), all further cases as white cards.
   Fields: subtitle, heading, lead
   ========================================================================= #}

{%- set cases = craft.entries.section('cases').all() -%}
{%- set featured = cases|first -%}
{%- set others = cases|slice(1) -%}
{%- set chipTones = ['bg-coral', 'bg-coral-light', 'bg-coral-trace'] -%}

<section class="container-wrap pt-16 pb-8 tablet:pt-24">
    <div class="mb-10 flex max-w-[720px] flex-col gap-4">
        {%- if entry.subtitle %}
            <p class="text-label text-ink-muted">{{ entry.subtitle }}</p>
        {%- endif %}
        <h2 class="text-section">{{ entry.heading }}</h2>
        {%- if entry.lead %}
            <p>{{ entry.lead }}</p>
        {%- endif %}
    </div>

    {%- if featured %}
        {%- set facts = (featured.overviewFacts ?? [])|filter(row => row.title ?? false) -%}
        {%- set tags = (featured.subtitle ?? '')|split(' · ') -%}
        <article class="mb-4 flex flex-wrap gap-8 bg-mist p-6 tablet:p-12">
            <div class="flex min-w-0 max-w-[860px] flex-[1_1_440px] flex-col gap-5">
                <div class="flex flex-wrap gap-2">
                    <span class="inline-flex h-7 items-center rounded-[2px] bg-coral px-[10px] text-label-sm text-ink">Fallbeispiel</span>
                    {%- if tags|last %}
                        <span class="inline-flex h-7 items-center rounded-[2px] bg-white px-[10px] text-label-sm text-ink">{{ tags|last }}</span>
                    {%- endif %}
                </div>
                <h3 class="font-display text-[clamp(30px,3.4vw,40px)] leading-[1.15]">{{ featured.title }}</h3>
                {%- if featured.summary %}
                    <p>{{ featured.summary }}</p>
                {%- endif %}
                {%- if facts|length %}
                    <dl class="grid grid-cols-[minmax(0,1fr)] bg-white phablet:grid-cols-[140px_minmax(0,1fr)]">
                        {%- for row in facts %}
                            {%- set line = not loop.last ? 'border-b border-line' -%}
                            <dt class="px-4 pt-[14px] text-label-sm leading-[22px] text-ink-muted phablet:pb-[14px] {{ not loop.last ? 'phablet:border-b phablet:border-line' }}">{{ row.title }}</dt>
                            <dd class="px-4 pb-[14px] text-copy-sm phablet:pt-[14px] {{ line }}">{{ row.text }}</dd>
                        {%- endfor %}
                    </dl>
                {%- endif %}
                {%- include '_partials/redesign/button' with {
                    text: 'Fallbeispiel lesen',
                    url: featured.url,
                    variant: 'navy',
                    arrow: true,
                    utilities: 'self-start',
                } only -%}
            </div>
        </article>
    {%- endif %}

    {%- if others|length %}
        <ul class="grid grid-cols-[repeat(auto-fit,minmax(min(300px,100%),1fr))] gap-4">
            {%- for case in others %}
                {%- set tags = (case.subtitle ?? '')|split(' · ')|filter -%}
                <li>
                    <a href="{{ case.url }}" class="group flex h-full min-h-[300px] flex-col gap-4 bg-white p-6 text-ink no-underline hover:text-ink">
                        {%- if tags|length %}
                            <span class="flex flex-wrap gap-2">
                                {%- for tag in tags %}
                                    <span class="inline-flex h-7 items-center rounded-[2px] px-[10px] text-label-sm text-ink {{ loop.first ? chipTones[loop.parent.loop.index0 % 3] : 'bg-ground' }}">{{ tag }}</span>
                                {%- endfor %}
                            </span>
                        {%- endif %}
                        <h3 class="text-[22px] leading-[30px] font-light group-hover:underline">{{ case.title }}</h3>
                        {%- if case.summary %}
                            <p class="grow text-copy-sm text-slate">{{ case.summary }}</p>
                        {%- endif %}
                        <span class="mt-auto text-label">Fallbeispiel lesen ↗</span>
                    </a>
                </li>
            {%- endfor %}
        </ul>
    {%- endif %}
</section>

{# =========================================================================
   Method teaser
   Grey box: label, heading, lead, round-arrow link; video (or image)
   next to a list with a petrol edge ("Danach wissen Sie, …").
   Fields: subtitle, heading, lead, headLink, video, image, listTitle,
           points (table: text)
   ========================================================================= #}

{%- set video = entry.video.one() ?? null -%}
{%- set image = entry.image.one() ?? null -%}
{%- set points = (entry.points ?? [])|filter(row => row.text ?? false) -%}
{%- set link = entry.headLink ?? null -%}
{%- set mediaClass = 'block aspect-video w-full min-w-0 flex-[3_1_560px] rounded-[24px] bg-ground object-cover' -%}

<section class="container-wrap pt-16 tablet:pt-24">
    <div class="flex flex-col gap-10 bg-mist p-6 tablet:p-12">
        <div class="flex flex-wrap items-end justify-between gap-6">
            <div class="flex max-w-[680px] flex-col gap-4">
                {%- if entry.subtitle %}
                    <p class="text-label text-ink-muted">{{ entry.subtitle }}</p>
                {%- endif %}
                <h2 class="text-section">
                    {%- include '_partials/redesign/highlight' with { text: entry.heading, utilities: 'text-plum' } only -%}
                </h2>
                {%- if entry.lead %}
                    <p class="text-[20px] leading-[30px] font-light">{{ entry.lead }}</p>
                {%- endif %}
            </div>
            {%- if link and link.url %}
                <a href="{{ link.url }}" class="group inline-flex items-center gap-3 text-label text-ink no-underline hover:text-navy"{% if link.target %} target="{{ link.target }}"{% endif %}>
                    {{- link.label -}}
                    <span class="inline-flex size-12 items-center justify-center rounded-full bg-white transition-colors group-hover:bg-navy group-hover:text-white">
                        {%- include '_partials/redesign/icon' with { name: 'arrow', utilities: 'size-[18px]' } only -%}
                    </span>
                </a>
            {%- endif %}
        </div>

        {%- if video or image or points|length %}
            <div class="flex flex-wrap items-center gap-8">
                {%- if video %}
                    <video controls preload="none" playsinline src="{{ video.url }}"
                           {%- if image %} poster="{{ image.getUrl({ width: 1400, format: 'webp', quality: 82 }) }}"{% endif %}
                           aria-label="{{ video.title }}" class="{{ mediaClass }}"></video>
                {%- elseif image %}
                    {{ tag('img', {
                        src: image.extension == 'svg' ? image.url : image.getUrl({ width: 1400, height: 788, mode: 'crop', format: 'webp', quality: 82 }),
                        alt: image.alt ?? '',
                        width: 1400,
                        height: 788,
                        loading: 'lazy',
                        class: mediaClass,
                    }) }}
                {%- endif %}

                {%- if points|length %}
                    <div class="flex min-w-0 flex-[2_1_320px] flex-col gap-3">
                        {%- if entry.listTitle %}
                            <p class="text-label text-ink-muted">{{ entry.listTitle }}</p>
                        {%- endif %}
                        <ul class="bg-white">
                            {%- for point in points %}
                                <li class="border-l-[3px] border-petrol px-5 py-[14px] text-[15px] leading-[23px] {{ not loop.last ? 'border-b border-b-line' }}">{{ point.text }}</li>
                            {%- endfor %}
                        </ul>
                    </div>
                {%- endif %}
            </div>
        {%- endif %}
    </div>
</section>

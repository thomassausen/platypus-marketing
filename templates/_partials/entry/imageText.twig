{# =========================================================================
   Image and text
   Image next to text in the 2026 design (square corners, no shadow).
   Fields: image, subtitle, title, description, text, button, imagePosition,
           imageOverhang (image bleeds to the viewport edge),
           backgroundColor, containerWidth
   imageRounding and svgVariant are no longer used.
   ========================================================================= #}

{%- import '_partials/theme-macros.twig' as theme -%}

{%- set vars = theme.getThemeVars(entry.backgroundColor.value ?? entry.backgroundColor ?? 'white')|json_decode -%}
{%- set container = theme.containerClass(entry.containerWidth.value ?? entry.containerWidth ?? null, 'default') -%}
{%- set image = entry.image.one() ?? null -%}
{%- set isSvg = image and image.extension == 'svg' -%}
{%- set imageRight = (entry.imagePosition.value ?? entry.imagePosition ?? 'left') == 'right' -%}
{%- set overhang = entry.imageOverhang ?? false -%}
{%- set bleed = overhang
    ? (imageRight ? 'tablet:-mr-[calc(max((100vw-1200px)/2,0px)+48px)]' : 'tablet:-ml-[calc(max((100vw-1200px)/2,0px)+48px)]')
    : '' -%}

<section class="relative overflow-hidden section-band {{ vars.backgroundClass }} {{ vars.textColorClass }}">
    <div class="{{ container }} grid items-center gap-8 tablet:grid-cols-[repeat(2,1fr)] tablet:gap-16">
        {%- if image %}
            <div class="{{ imageRight ? 'tablet:order-2' }} {{ bleed }}">
                {{ tag('img', {
                    class: isSvg ? 'h-auto w-full' : 'h-[300px] w-full object-cover tablet:h-[500px]',
                    width: 1200,
                    height: 900,
                    src: isSvg ? image.url : image.getUrl({ format: 'webp', quality: 85, width: 1200, height: 900, mode: 'crop' }),
                    alt: image.alt ?? image.title,
                    loading: 'lazy',
                }) }}
            </div>
        {%- endif %}
        <div>
            {%- include '_partials/text-content' with {
                subtitle: entry.subtitle,
                title: entry.title,
                description: entry.description,
                text: entry.text,
                button: entry.button,
                vars: vars,
            } only -%}
        </div>
    </div>
</section>

{# =========================================================================
   Text list
   Text on the left, feature list card on the right (2026 design).
   Fields: subtitle, title, description, text, featuresTitle, featuresIntro,
           featuresTable (title/description), featuresFooter,
           backgroundColor, containerWidth
   ========================================================================= #}

{%- import '_partials/theme-macros.twig' as theme -%}

{%- set vars = theme.getThemeVars(entry.backgroundColor.value ?? entry.backgroundColor ?? 'soft')|json_decode -%}
{%- set container = theme.containerClass(entry.containerWidth.value ?? entry.containerWidth ?? null, 'default') -%}
{%- set features = (entry.featuresTable ?? [])|filter(row => row.title ?? false) -%}

<section class="relative overflow-hidden section-band {{ vars.backgroundClass }} {{ vars.textColorClass }}">
    <div class="{{ container }} grid items-center gap-8 tablet:grid-cols-[repeat(2,1fr)] tablet:gap-16">
        <div>
            {%- include '_partials/text-content' with {
                subtitle: entry.subtitle,
                title: entry.title,
                description: entry.description,
                text: entry.text,
                vars: vars,
            } only -%}
        </div>

        <div class="p-8 tablet:p-12 {{ vars.cardBgClass }} {{ vars.cardTextClass }}">
            {%- if entry.featuresTitle %}
                <h3 class="text-h3 {{ vars.cardTitleClass }}">{{ entry.featuresTitle }}</h3>
            {%- endif %}
            {%- if entry.featuresIntro %}
                <div class="prose-plain content-styles mt-5">{{ entry.featuresIntro }}</div>
            {%- endif %}
            {%- if features|length %}
                <ul class="mt-6">
                    {%- for feature in features %}
                        <li class="flex items-baseline gap-[14px] border-t py-[14px] {{ vars.lineClass }} before:size-2 before:flex-none before:-translate-y-0.5 before:rounded-full before:content-[''] {{ vars.bulletClass }}">
                            <div>
                                <strong class="block font-bold">{{ feature.title }}</strong>
                                {%- if feature.description ?? false %}
                                    <span class="mt-1 block text-copy-sm {{ vars.mutedClass }}">{{ feature.description }}</span>
                                {%- endif %}
                            </div>
                        </li>
                    {%- endfor %}
                </ul>
            {%- endif %}
            {%- if entry.featuresFooter %}
                <div class="prose-plain content-styles mt-6">{{ entry.featuresFooter }}</div>
            {%- endif %}
        </div>
    </div>
</section>

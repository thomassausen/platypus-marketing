{# =========================================================================
   Quote
   Quote in the display face, as in the 2026 case study card.
   Fields: text, creator, textAlignment, backgroundColor, containerWidth
   svgVariant is no longer used.
   ========================================================================= #}

{%- import '_partials/theme-macros.twig' as theme -%}

{%- set vars = theme.getThemeVars(entry.backgroundColor.value ?? entry.backgroundColor ?? 'white')|json_decode -%}
{%- set container = theme.containerClass(entry.containerWidth.value ?? entry.containerWidth ?? null, 'default') -%}
{%- set centered = (entry.textAlignment.value ?? entry.textAlignment ?? 'center') == 'center' -%}

<section class="relative section-band {{ vars.backgroundClass }} {{ vars.textColorClass }}">
    <div class="{{ container }}">
        <figure class="flex flex-col gap-7 border-l-4 py-2 pl-8 tablet:pl-12 {{ vars.accentBorderClass }} {{ centered ? 'mx-auto max-w-[860px]' : 'max-w-[860px]' }}">
            {%- if entry.text %}
                <blockquote class="prose-plain text-quote {{ vars.titleColorClass }}">{{ entry.text }}</blockquote>
            {%- endif %}
            {%- if entry.creator %}
                <figcaption class="text-label {{ vars.subtitleBgClass }}">{{ entry.creator }}</figcaption>
            {%- endif %}
        </figure>
    </div>
</section>

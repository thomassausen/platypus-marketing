{# =========================================================================
   Hero
   Navy statement hero of the 2026 design.
   Fields: subtitle (label), heading (*…* = gold), text, buttons
           (primary = gold, secondary = outline), facts (table: title/text).
   The older fields heroVariant, backgroundColor, svgVariant, image,
   floatingCard and containerWidth are no longer used.
   ========================================================================= #}

{%- set facts = (entry.facts ?? [])|filter(row => row.title ?? false) -%}

<section class="relative overflow-hidden scroll-mt-24 bg-navy-deep pt-20 pb-[72px] text-white tablet:pt-[120px] tablet:pb-[104px]">
    {%- include '_partials/redesign/platypus-mark' with {
        utilities: 'pointer-events-none absolute -right-[4%] -bottom-5 w-[90vw] text-petrol opacity-55 tablet:top-24 tablet:bottom-auto tablet:w-[min(52vw,680px)] tablet:opacity-20',
    } only -%}

    <div class="container-wrap relative z-[1]">
        {%- if entry.subtitle %}
            <p class="text-label text-petrol">{{ entry.subtitle }}</p>
        {%- endif %}

        <h1 class="mt-7 max-w-[15ch] text-statement">
            {%- include '_partials/redesign/highlight' with { text: entry.heading, utilities: 'text-gold' } only -%}
        </h1>

        {%- if entry.text %}
            <div class="prose-plain mt-10 max-w-[46ch] text-[clamp(20px,2.2vw,24px)] leading-[1.5] font-light text-ink-soft">
                {{ entry.text }}
            </div>
        {%- endif %}

        {%- set buttons = entry.buttons.all() -%}
        {%- if buttons|length %}
            <div class="mt-10 flex flex-wrap gap-3">
                {%- include '_partials/redesign/buttons' with {
                    buttons: buttons,
                    primary: 'gold',
                    secondary: 'outline-light',
                    utilities: 'max-phablet:w-full max-phablet:justify-center',
                } only -%}
            </div>
        {%- endif %}

        {%- if facts|length %}
            <div class="mt-[88px] grid gap-px border-t border-white/14 bg-white/14 tablet:grid-cols-[repeat(3,1fr)]">
                {%- for fact in facts %}
                    <div class="bg-navy-deep pt-6 pr-6">
                        <strong class="block text-[22px] leading-[30px] font-light text-white">{{ fact.title }}</strong>
                        {%- if fact.text ?? false %}
                            <span class="mt-1.5 block text-copy-sm text-ink-light">{{ fact.text }}</span>
                        {%- endif %}
                    </div>
                {%- endfor %}
            </div>
        {%- endif %}
    </div>
</section>

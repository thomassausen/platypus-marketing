{# =========================================================================
   Services
   Coloured service cards, styled like the 2026 model cards.
   Fields: subtitle, heading, description, text, services (title, text,
           color, link), columns, firstFullWidth, backgroundColor,
           containerWidth
   ========================================================================= #}

{%- import '_partials/theme-macros.twig' as theme -%}
{%- import '_partials/ui-macros.twig' as ui -%}

{%- set vars = theme.getThemeVars(entry.backgroundColor.value ?? entry.backgroundColor ?? 'white')|json_decode -%}
{%- set container = theme.containerClass(entry.containerWidth.value ?? entry.containerWidth ?? null, 'default') -%}
{%- set services = entry.services.all() -%}
{%- set columns = (entry.columns.value ?? entry.columns ?? 2)|number_format -%}
{%- set gridClasses = {
    '2': 'tablet:grid-cols-[repeat(2,1fr)]',
    '3': 'tablet:grid-cols-[repeat(2,1fr)] desktop:grid-cols-[repeat(3,1fr)]',
    '4': 'tablet:grid-cols-[repeat(2,1fr)] desktop:grid-cols-[repeat(4,1fr)]',
} -%}
{%- set firstFull = (entry.firstFullWidth ?? false) and services|length >= 4 -%}
{%- set grid = firstFull ? gridClasses['3'] : (gridClasses[columns] ?? gridClasses['2']) -%}

<section class="relative overflow-hidden section-band {{ vars.backgroundClass }} {{ vars.textColorClass }}">
    <div class="{{ container }}">
        {{ ui.sectionHeader(entry.subtitle, entry.heading, entry.description, entry.text, vars, 'left') }}

        {%- if services|length %}
            <div class="mt-14 grid gap-4 {{ grid }}">
                {%- for service in services %}
                    {%- set colors = theme.serviceColorClass(service.color) -%}
                    {%- set isWide = firstFull and loop.first -%}
                    {%- set isNavy = 'bg-navy' in colors -%}
                    <article class="flex flex-col gap-4 p-8 {{ colors }} {{ isWide ? 'col-span-full tablet:p-12' }}">
                        <h3 class="{{ isWide ? 'text-statement-md' : 'font-display text-[32px] leading-[1.1]' }}">{{ service.title }}</h3>
                        {%- if service.text %}
                            <div class="prose-plain content-styles {{ isWide ? 'max-w-[64ch]' : 'text-copy-sm' }}">{{ service.text }}</div>
                        {%- endif %}
                        {%- if service.link and service.link.url %}
                            <a href="{{ service.link.url }}" class="mt-auto inline-flex items-center gap-2 pt-2 text-label leading-[26px] no-underline hover:underline {{ isNavy ? 'text-gold' }}"{% if service.link.target %} target="{{ service.link.target }}"{% endif %}>
                                {{- service.link.label -}}
                                {% include '_partials/redesign/icon' with { name: 'arrow', utilities: 'size-4' } only %}
                            </a>
                        {%- endif %}
                    </article>
                {%- endfor %}
            </div>
        {%- endif %}
    </div>
</section>

{# =========================================================================
   Team
   Team members with square photo, name and contact (2026 design).
   Fields: subtitle, heading, text, teamMembers (title, image, text, email,
           phone), backgroundColor, containerWidth
   ========================================================================= #}

{%- import '_partials/theme-macros.twig' as theme -%}
{%- import '_partials/ui-macros.twig' as ui -%}

{%- set vars = theme.getThemeVars(entry.backgroundColor.value ?? entry.backgroundColor ?? 'soft')|json_decode -%}
{%- set container = theme.containerClass(entry.containerWidth.value ?? entry.containerWidth ?? null, 'default') -%}
{%- set members = entry.teamMembers.all() -%}

<section class="relative section-band {{ vars.backgroundClass }} {{ vars.textColorClass }}">
    <div class="{{ container }}">
        {{ ui.sectionHeader(entry.subtitle, entry.heading, null, entry.text, vars, 'left') }}

        {%- if members|length %}
            <div class="mt-14 grid gap-4 tablet:grid-cols-[repeat(2,1fr)]">
                {%- for member in members %}
                    {%- set photo = member.image.one() ?? null -%}
                    <article class="flex flex-col {{ vars.dark ? 'bg-white text-ink' : vars.cardBgClass ~ ' text-ink' }}">
                        {%- if photo %}
                            {{ tag('img', {
                                class: 'aspect-square w-full object-cover',
                                width: 800,
                                height: 800,
                                src: photo.getUrl({ format: 'webp', quality: 85, width: 800, height: 800, mode: 'crop' }),
                                alt: photo.alt ?? member.title,
                                loading: 'lazy',
                            }) }}
                        {%- endif %}
                        <div class="flex flex-col gap-4 p-8">
                            <h3 class="text-h3">{{ member.title }}</h3>
                            {%- if member.email or (member.phone and member.phone.url) %}
                                <ul class="space-y-2 text-copy-sm">
                                    {%- if member.email %}
                                        <li>
                                            <a href="mailto:{{ member.email }}" class="inline-flex items-center gap-2 no-underline hover:text-navy hover:underline">
                                                {%- include '_partials/redesign/icon' with { name: 'mail', utilities: 'size-4' } only -%}
                                                {{ member.email }}
                                            </a>
                                        </li>
                                    {%- endif %}
                                    {%- if member.phone and member.phone.url %}
                                        <li>
                                            <a href="{{ member.phone.url|replace({' ': ''}) }}" class="inline-flex items-center gap-2 no-underline hover:text-navy hover:underline">
                                                {%- include '_partials/redesign/icon' with { name: 'phone', utilities: 'size-4' } only -%}
                                                {{ member.phone.label }}
                                            </a>
                                        </li>
                                    {%- endif %}
                                </ul>
                            {%- endif %}
                            {%- if member.text %}
                                <div class="prose-plain content-styles border-t border-ink/18 pt-4 text-copy-sm text-ink-muted">{{ member.text }}</div>
                            {%- endif %}
                        </div>
                    </article>
                {%- endfor %}
            </div>
        {%- endif %}
    </div>
</section>

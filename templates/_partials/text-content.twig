{# =========================================================================
   Text content
   Label, heading, lead, rich text and button in the 2026 design.
   Props: subtitle, title, description, text, button, vars (theme vars)
   ========================================================================= #}

{%- import '_partials/ui-macros.twig' as ui -%}

{{ ui.subtitle(subtitle ?? null, vars.subtitleBgClass) }}
{%- if title ?? false %}
    <h2 class="text-h2 {{ vars.titleColorClass }}">{{ title }}</h2>
{%- endif %}
{%- if description ?? false %}
    <div class="prose-plain content-styles mt-5 text-lead {{ vars.textColorClass }}">{{ description }}</div>
{%- endif %}
{%- if text ?? false %}
    <div class="prose-plain content-styles mt-5 {{ vars.textColorClass }}">{{ text }}</div>
{%- endif %}
{%- if (button ?? null) and button.url %}
    <div class="mt-10">{{ ui.buttonPrimary(button, vars.buttonPrimary) }}</div>
{%- endif %}

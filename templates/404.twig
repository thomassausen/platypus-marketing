{# =========================================================================
   404
   Navy page in the hero style: large "404", message, button to the home
   page and the main navigation as direct links.
   ========================================================================= #}

{% extends "_layouts/default" %}

{%- set hideNextStep = true -%}

{% block content %}
    {%- set pages = craft.entries.section('mainNavigation').level(1).with(['children']).all() -%}

    <section class="relative flex min-h-[calc(100svh-132px)] items-center overflow-hidden bg-navy-deep py-20 text-white tablet:py-[104px]">
        {%- include '_partials/redesign/platypus-mark' with {
            utilities: 'pointer-events-none absolute -right-[8%] -bottom-6 w-[110vw] text-petrol opacity-25 tablet:right-auto tablet:-left-[4%] tablet:w-[min(46vw,640px)] tablet:opacity-15',
        } only -%}

        <div class="container-wrap relative z-[1] grid w-full items-center gap-10 tablet:grid-cols-[1fr_1.1fr] tablet:gap-16">
            <p class="font-display text-[clamp(120px,20vw,260px)] leading-[.85] tracking-[-.02em] text-gold" aria-hidden="true">404</p>

            <div>
                <p class="text-label text-petrol">Fehler 404</p>
                <h1 class="mt-5 text-statement-md">Seite nicht gefunden</h1>
                <p class="mt-6 max-w-[46ch] text-[clamp(19px,2vw,22px)] leading-[1.5] font-light text-ink-soft">
                    Die gesuchte Seite existiert leider nicht (mehr).
                    Vielleicht finden Sie auf unserer Startseite, was Sie suchen.
                </p>

                <div class="mt-10">
                    {%- include '_partials/redesign/button' with {
                        text: 'Zur Startseite',
                        url: siteUrl,
                        variant: 'gold',
                        arrow: true,
                    } only -%}
                </div>

                {%- if pages|length %}
                    <nav class="mt-14 border-t border-white/14 pt-6" aria-label="Weitere Seiten">
                        <p class="text-label-sm text-ink-light">Oder direkt weiter zu</p>
                        <ul class="mt-4 flex flex-wrap gap-2">
                            {%- for page in pages %}
                                {%- for item in [page]|merge(page.children.all()) %}
                                    {%- set link = item.customLink -%}
                                    {%- if link and link.url %}
                                        <li>
                                            <a href="{{ link.url }}" class="inline-flex h-[34px] items-center rounded-[3px] bg-petrol/18 px-[14px] text-[11px] font-bold tracking-[.14em] text-petrol uppercase no-underline transition-colors hover:bg-petrol hover:text-ink">{{ link.label }}</a>
                                        </li>
                                    {%- endif %}
                                {%- endfor %}
                            {%- endfor %}
                            <li>
                                <a href="{{ url('blog') }}" class="inline-flex h-[34px] items-center rounded-[3px] bg-petrol/18 px-[14px] text-[11px] font-bold tracking-[.14em] text-petrol uppercase no-underline transition-colors hover:bg-petrol hover:text-ink">Blog</a>
                            </li>
                        </ul>
                    </nav>
                {%- endif %}
            </div>
        </div>
    </section>
{% endblock %}

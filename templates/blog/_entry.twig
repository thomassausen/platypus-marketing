{# =========================================================================
   Blog post
   Navy header, featured image overlapping it, reading column,
   previous/next navigation, related posts.
   ========================================================================= #}

{% extends "_layouts/default" %}

{% block content %}
    {%- set image = entry.blogFeaturedImage.one() ?? null -%}
    {%- set prevEntry = craft.entries().section('blog').postDate('< ' ~ entry.postDate|date('Y-m-d H:i:s')).orderBy('postDate DESC').one() -%}
    {%- set nextEntry = craft.entries().section('blog').postDate('> ' ~ entry.postDate|date('Y-m-d H:i:s')).orderBy('postDate ASC').one() -%}
    {%- set relatedPosts = craft.entries().section('blog').id('not ' ~ entry.id).orderBy('RAND()').limit(3).with(['blogFeaturedImage']).all() -%}

    <article>
        {# Header #}
        <header class="relative overflow-hidden bg-navy-deep pt-20 text-white tablet:pt-[104px] {{ image ? 'pb-40 tablet:pb-56' : 'pb-[72px] tablet:pb-[88px]' }}">
            {%- include '_partials/redesign/platypus-mark' with {
                utilities: 'pointer-events-none absolute -right-[6%] top-16 hidden w-[min(40vw,520px)] text-petrol opacity-15 tablet:block',
            } only -%}
            <div class="container-wrap relative z-[1]">
                <div class="mx-auto max-w-[880px]">
                    <p class="text-label text-petrol">
                        <time datetime="{{ entry.postDate|date('Y-m-d') }}">{{ entry.postDate|date('d. F Y') }}</time>
                        {%- if entry.author %} · {{ entry.author.fullName }}{% endif %}
                    </p>
                    <h1 class="mt-6 text-statement-md">{{ entry.title }}</h1>
                    {%- if entry.blogSummary %}
                        <p class="mt-8 max-w-[52ch] text-[clamp(19px,2vw,22px)] leading-[1.5] font-light text-ink-soft">{{ entry.blogSummary }}</p>
                    {%- endif %}
                </div>
            </div>
        </header>

        {# Featured image, overlapping the header #}
        {%- if image %}
            <div class="container-wrap relative z-[2] -mt-28 tablet:-mt-40">
                <figure class="mx-auto max-w-[1040px]">
                    {{ tag('img', {
                        src: image.extension == 'svg' ? image.url : image.getUrl({ width: 2080, height: 1170, mode: 'crop', format: 'webp', quality: 82 }),
                        alt: image.alt ?? '',
                        width: 2080,
                        height: 1170,
                        class: 'aspect-video w-full bg-beige object-cover',
                    }) }}
                    {%- if image.alt %}
                        <figcaption class="mt-3 text-caption text-ink-muted">{{ image.alt }}</figcaption>
                    {%- endif %}
                </figure>
            </div>
        {%- endif %}

        {# Body #}
        <div class="container-wrap pt-14 pb-20 tablet:pt-20 tablet:pb-28">
            {%- if entry.blogContent %}
                <div class="blog-content content-styles prose-plain mx-auto max-w-[720px] text-[18px] leading-[30px] [&_blockquote]:my-10 [&_blockquote]:border-l-4 [&_blockquote]:border-gold [&_blockquote]:pl-6 [&_blockquote]:font-display [&_blockquote]:text-[26px] [&_blockquote]:leading-[1.3] [&_img]:my-8 [&_img]:h-auto">
                    {{ entry.blogContent }}
                </div>
            {%- endif %}

            {# Previous / overview / next #}
            <nav class="mx-auto mt-16 max-w-[880px] border-t border-line pt-10" aria-label="Weitere Beiträge">
                <div class="grid gap-4 tablet:grid-cols-[repeat(2,1fr)]">
                    {%- if prevEntry %}
                        <a href="{{ prevEntry.url }}" class="group flex flex-col gap-2 bg-white p-6 no-underline hover:text-navy">
                            <span class="inline-flex items-center gap-2 text-label-sm text-ink-muted">
                                {%- include '_partials/redesign/icon' with { name: 'chevron', utilities: 'size-4 rotate-90 transition-transform group-hover:-translate-x-0.5' } only -%}
                                Vorheriger Beitrag
                            </span>
                            <span class="text-[19px] leading-[26px]">{{ prevEntry.title }}</span>
                        </a>
                    {%- else %}
                        <span class="hidden tablet:block"></span>
                    {%- endif %}
                    {%- if nextEntry %}
                        <a href="{{ nextEntry.url }}" class="group flex flex-col gap-2 bg-white p-6 no-underline hover:text-navy tablet:items-end tablet:text-right">
                            <span class="inline-flex items-center gap-2 text-label-sm text-ink-muted">
                                Nächster Beitrag
                                {%- include '_partials/redesign/icon' with { name: 'chevron', utilities: 'size-4 -rotate-90 transition-transform group-hover:translate-x-0.5' } only -%}
                            </span>
                            <span class="text-[19px] leading-[26px]">{{ nextEntry.title }}</span>
                        </a>
                    {%- endif %}
                </div>
                <div class="mt-8 text-center">
                    {%- include '_partials/redesign/button' with { text: 'Zur Übersicht', url: url('blog'), variant: 'outline' } only -%}
                </div>
            </nav>
        </div>
    </article>

    {# Related posts #}
    {%- if relatedPosts|length %}
        <section class="section-band bg-beige">
            <div class="container-wrap">
                <p class="text-label text-navy">Weiterlesen</p>
                <h2 class="mt-5 text-h2">Weitere Beiträge</h2>
                <div class="mt-14 grid gap-4 tablet:grid-cols-[repeat(2,1fr)] desktop:grid-cols-[repeat(3,1fr)]">
                    {%- for post in relatedPosts %}
                        {%- include '_partials/redesign/blog-card' with { post: post } only -%}
                    {%- endfor %}
                </div>
            </div>
        </section>
    {%- endif %}
{% endblock %}

{# =========================================================================
   News (blog index)
   Intro, topic filter (?thema=<slug>), one wide card per post (topic
   panel left, meta/title/summary right), pagination, newsletter box.
   ========================================================================= #}

{% extends "_layouts/default" %}

{%- set seoTitle = 'News' -%}

{%- import '_partials/theme-macros.twig' as theme -%}

{% block content %}
    {%- set topics = craft.entries.section('topics').all() -%}
    {%- set activeSlug = craft.app.request.getQueryParam('thema') -%}
    {%- set activeTopic = activeSlug ? topics|filter(topic => topic.slug == activeSlug)|first : null -%}
    {%- set query = craft.entries().section('blog').orderBy('postDate DESC').with(['topic']).limit(8) -%}
    {%- if activeTopic %}{% do query.relatedTo({ targetElement: activeTopic, field: 'topic' }) %}{% endif -%}
    {%- paginate query as pageInfo, posts -%}
    {%- set filterClass = 'inline-flex min-h-11 items-center rounded-[4px] border px-4 text-label no-underline transition-colors' -%}

    {# Intro + filter #}
    <section class="container-wrap pt-10 tablet:pt-16">
        <div class="flex max-w-[680px] flex-col gap-6">
            <p class="text-label text-ink-muted">News · Schon gewusst?</p>
            <h1 class="text-[clamp(38px,4.6vw,56px)] leading-[1.14] font-light tracking-[-.02em]">Sichtbar werden im Dschungel der Angebote.</h1>
            <p class="text-[20px] leading-[30px] font-light">Analysen, Branchendaten und Gedankenspiele zur Positionierung im KI-Zeitalter – wertvoller Input für Personalberatungen und Executive-Search-Boutiquen, jeder Beitrag mit belegter Herkunft.</p>
        </div>

        {%- if topics|length %}
            <nav aria-label="Nach Thema filtern" class="mt-10 flex flex-wrap gap-2">
                <a href="{{ url('blog') }}" class="{{ filterClass }} {{ activeTopic ? 'border-line bg-white text-ink hover:border-navy hover:text-navy' : 'border-navy bg-navy text-white hover:text-white' }}"{% if not activeTopic %} aria-current="page"{% endif %}>Alle Themen</a>
                {%- for topic in topics %}
                    {%- set active = activeTopic and activeTopic.id == topic.id -%}
                    <a href="{{ url('blog', { thema: topic.slug }) }}" class="{{ filterClass }} {{ active ? 'border-navy bg-navy text-white hover:text-white' : 'border-line bg-white text-ink hover:border-navy hover:text-navy' }}"{% if active %} aria-current="page"{% endif %}>{{ topic.shortLabel ?: topic.title }}</a>
                {%- endfor %}
            </nav>
        {%- endif %}
    </section>

    {# Posts #}
    <section aria-label="Beiträge" class="container-wrap pt-8">
        {%- if posts|length %}
            <div class="flex flex-col gap-4">
                {%- for post in posts %}
                    {%- set topic = post.topic|first -%}
                    {%- set number = (pageInfo.currentPage - 1) * 8 + loop.index -%}
                    <article class="group relative flex flex-wrap bg-white">
                        <div class="flex min-h-[200px] min-w-[min(240px,100%)] flex-[0_1_300px] flex-col justify-between gap-8 p-8 tablet:min-h-[240px] {{ theme.topicClass(topic, 'panel') }}">
                            <span class="text-label-sm">Beitrag {{ number }}</span>
                            {%- if topic %}
                                <p class="text-[28px] leading-9 font-light">{{ topic.title }}</p>
                            {%- endif %}
                        </div>
                        <div class="flex min-w-0 flex-[1_1_480px] flex-col gap-4 p-8">
                            <p class="text-caption text-ink-muted">
                                <time datetime="{{ post.postDate|date('Y-m-d') }}">{{ post.postDate|date('d. F Y') }}</time> · {{ theme.readingTime(post) }} Min. Lesezeit
                            </p>
                            <h2 class="text-[28px] leading-9 font-light">
                                <a href="{{ post.url }}" class="text-ink no-underline after:absolute after:inset-0 after:content-[''] hover:text-ink group-hover:underline">{{ post.title }}</a>
                            </h2>
                            {%- if post.blogSummary %}
                                <p class="max-w-[640px]">{{ post.blogSummary }}</p>
                            {%- endif %}
                            <span class="mt-auto inline-flex items-center gap-3 self-start text-label" aria-hidden="true">
                                Weiterlesen
                                <span class="inline-flex size-11 items-center justify-center rounded-full bg-mist transition-colors group-hover:bg-navy group-hover:text-white">
                                    {%- include '_partials/redesign/icon' with { name: 'arrow', utilities: 'size-[18px]' } only -%}
                                </span>
                            </span>
                        </div>
                    </article>
                {%- endfor %}
            </div>

            {# Pagination #}
            {%- if pageInfo.totalPages > 1 %}
                {%- set pageLink = 'grid size-11 place-items-center rounded-[4px] border border-line bg-white text-label no-underline hover:border-navy hover:text-navy' -%}
                <nav class="mt-10 flex flex-wrap items-center justify-center gap-2" aria-label="Seitennavigation">
                    {%- if pageInfo.prevUrl %}
                        <a href="{{ pageInfo.prevUrl }}" class="{{ pageLink }}" aria-label="Vorherige Seite">
                            {%- include '_partials/redesign/icon' with { name: 'chevron', utilities: 'size-5 rotate-90' } only -%}
                        </a>
                    {%- endif %}
                    {%- for page, url in pageInfo.getPrevUrls(2) %}
                        <a href="{{ url }}" class="{{ pageLink }}">{{ page }}</a>
                    {%- endfor %}
                    <span class="grid size-11 place-items-center rounded-[4px] bg-navy text-label text-white" aria-current="page">{{ pageInfo.currentPage }}</span>
                    {%- for page, url in pageInfo.getNextUrls(2) %}
                        <a href="{{ url }}" class="{{ pageLink }}">{{ page }}</a>
                    {%- endfor %}
                    {%- if pageInfo.nextUrl %}
                        <a href="{{ pageInfo.nextUrl }}" class="{{ pageLink }}" aria-label="Nächste Seite">
                            {%- include '_partials/redesign/icon' with { name: 'chevron', utilities: 'size-5 -rotate-90' } only -%}
                        </a>
                    {%- endif %}
                </nav>
            {%- endif %}
        {%- else %}
            <p class="text-lead text-ink-muted">{{ activeTopic ? 'Zu diesem Thema gibt es noch keine Beiträge.' : 'Noch keine Beiträge veröffentlicht.' }}</p>
        {%- endif %}
    </section>

    {%- include '_partials/redesign/newsletter-box' with { id: 'news-email' } only -%}
{% endblock %}

{# =========================================================================
   Blog index
   Navy header, first post of each page as lead story, card grid (2 × 3),
   pagination.
   ========================================================================= #}

{% extends "_layouts/default" %}

{% block content %}
    {%- set query = craft.entries().section('blog').orderBy('postDate DESC').with(['blogFeaturedImage']).limit(7) -%}
    {%- paginate query as pageInfo, posts -%}
    {%- set lead = posts|first -%}
    {%- set gridPosts = lead ? posts|slice(1) : posts -%}

    {# Header #}
    <section class="relative overflow-hidden bg-navy-deep pt-20 pb-[72px] text-white tablet:pt-[104px] tablet:pb-[88px]">
        {%- include '_partials/redesign/platypus-mark' with {
            utilities: 'pointer-events-none absolute -right-[4%] -bottom-5 w-[90vw] text-petrol opacity-40 tablet:top-16 tablet:bottom-auto tablet:w-[min(44vw,560px)] tablet:opacity-20',
        } only -%}
        <div class="container-wrap relative z-[1]">
            <h1 class="max-w-[16ch] text-statement">Blog</h1>
            <p class="mt-8 max-w-[46ch] text-[clamp(19px,2vw,22px)] leading-[1.5] font-light text-ink-soft">Neuigkeiten, Einblicke und Expertenwissen aus unserer Welt</p>
        </div>
    </section>

    <section class="section-band bg-ground">
        <div class="container-wrap">
            {%- if posts|length %}
                {# Lead story #}
                {%- if lead %}
                    {%- set leadImage = lead.blogFeaturedImage|first -%}
                    <article class="group relative grid bg-white tablet:grid-cols-[1.25fr_1fr]">
                        <div class="aspect-[3/2] overflow-hidden bg-beige tablet:aspect-auto tablet:min-h-[420px]">
                            {%- if leadImage %}
                                {{ tag('img', {
                                    src: leadImage.extension == 'svg' ? leadImage.url : leadImage.getUrl({ width: 1200, height: 800, mode: 'crop', format: 'webp', quality: 82 }),
                                    alt: '',
                                    width: 1200,
                                    height: 800,
                                    class: 'h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100',
                                }) }}
                            {%- else %}
                                <div class="grid h-full place-items-center">
                                    {%- include '_partials/redesign/platypus-mark' with { utilities: 'w-1/2 text-petrol' } only -%}
                                </div>
                            {%- endif %}
                        </div>
                        <div class="flex flex-col gap-5 p-8 tablet:p-12">
                            <p class="text-label text-gold-deep">
                                {% if pageInfo.currentPage == 1 %}Neuester Beitrag · {% endif %}<time datetime="{{ lead.postDate|date('Y-m-d') }}">{{ lead.postDate|date('d. F Y') }}</time>
                            </p>
                            <h2 class="text-h2">
                                <a href="{{ lead.url }}" class="no-underline after:absolute after:inset-0 after:content-[''] group-hover:text-navy">{{ lead.title }}</a>
                            </h2>
                            {%- if lead.blogSummary %}
                                <p class="text-lead text-ink-muted">{{ lead.blogSummary }}</p>
                            {%- endif %}
                            <span class="mt-auto inline-flex items-center gap-2 pt-2 text-label leading-[26px] text-navy" aria-hidden="true">
                                Beitrag lesen
                                {%- include '_partials/redesign/icon' with { name: 'arrow', utilities: 'size-4 transition-transform duration-150 group-hover:translate-x-0.5 group-hover:-translate-y-0.5' } only -%}
                            </span>
                        </div>
                    </article>
                {%- endif %}

                {# Grid #}
                {%- if gridPosts|length %}
                    <div class="{{ lead ? 'mt-4' }} grid gap-4 tablet:grid-cols-[repeat(2,1fr)] desktop:grid-cols-[repeat(3,1fr)]">
                        {%- for post in gridPosts %}
                            {%- include '_partials/redesign/blog-card' with { post: post, headingLevel: 2 } only -%}
                        {%- endfor %}
                    </div>
                {%- endif %}

                {# Pagination #}
                {%- if pageInfo.totalPages > 1 %}
                    {%- set pageLink = 'grid size-11 place-items-center rounded-[3px] border border-line bg-white text-label leading-[26px] no-underline hover:border-navy hover:text-navy' -%}
                    <nav class="mt-14 flex flex-wrap items-center justify-center gap-2" aria-label="Seitennavigation">
                        {%- if pageInfo.prevUrl %}
                            <a href="{{ pageInfo.prevUrl }}" class="{{ pageLink }}" aria-label="Vorherige Seite">
                                {%- include '_partials/redesign/icon' with { name: 'chevron', utilities: 'size-5 rotate-90' } only -%}
                            </a>
                        {%- endif %}
                        {%- for page, url in pageInfo.getPrevUrls(2) %}
                            <a href="{{ url }}" class="{{ pageLink }}">{{ page }}</a>
                        {%- endfor %}
                        <span class="grid size-11 place-items-center rounded-[3px] bg-navy text-label leading-[26px] text-white" aria-current="page">{{ pageInfo.currentPage }}</span>
                        {%- for page, url in pageInfo.getNextUrls(2) %}
                            <a href="{{ url }}" class="{{ pageLink }}">{{ page }}</a>
                        {%- endfor %}
                        {%- if pageInfo.nextUrl %}
                            <a href="{{ pageInfo.nextUrl }}" class="{{ pageLink }}" aria-label="Nächste Seite">
                                {%- include '_partials/redesign/icon' with { name: 'chevron', utilities: 'size-5 -rotate-90' } only -%}
                            </a>
                        {%- endif %}
                    </nav>
                {%- endif %}
            {%- else %}
                <p class="text-lead text-ink-muted">Noch keine Beiträge veröffentlicht.</p>
            {%- endif %}
        </div>
    </section>
{% endblock %}
